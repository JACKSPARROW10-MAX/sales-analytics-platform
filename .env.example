# ==============================================================================
# SALES ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local development or cloud deployment.
# NEVER commit actual secrets to source control.
# ==============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
# For Cloud PostgreSQL (Supabase, Neon, Render, Railway, AWS RDS, etc.):
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# For Local Docker Compose (defaults to local docker postgres container):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_platform

# Fallback local PostgreSQL variables (used if DATABASE_URL is not set):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── Server & Network Configuration ──────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (comma-separated for production domains)
# Example: CORS_ORIGINS=http://localhost:5173,https://my-sales-app.vercel.app
CORS_ORIGINS=*

# ─── GenAI & ML Configuration ────────────────────────────────────────────────
# Groq API Key for dynamic LLM-driven prescriptive recommendations:
GROQ_API_KEY=your_groq_api_key_here

# ─── Automated Weekly Email Reporting (SMTP) ──────────────────────────────────
# For Gmail, use an App Password (Google Account > Security > App Passwords)
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password_here
REPORT_RECIPIENT=recipient@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ─── PgAdmin Configuration (Local Docker Only) ────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
