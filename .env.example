# ==============================================================================
# SALES ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local development or cloud deployment.
# NEVER commit actual secrets to source control.
# ==============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
# Single source of truth for the database connection. Set this in your local
# .env file only - never commit a real value.
#   Local Docker Compose:  postgresql://postgres:postgres@localhost:5432/sales_platform
#   Supabase (session pooler, IPv4-friendly):
#       postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Other cloud PostgreSQL (Neon, RDS, Render, Railway, ...):
#       postgresql://<user>:<password>@<host>:<port>/<database>
# TLS is enforced automatically for non-local hosts (sslmode=require).
# If the password contains reserved URL characters (@ : / ? # etc.), percent-encode them.
DATABASE_URL=

# Fallback local PostgreSQL variables (used only if DATABASE_URL is not set):
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# ─── Server & Network Configuration ──────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Allowed CORS Origins (comma-separated for production domains)
# Example: CORS_ORIGINS=http://localhost:5173,https://my-sales-app.vercel.app
CORS_ORIGINS=*

# ─── GenAI & ML Configuration ────────────────────────────────────────────────
# Groq API Key for dynamic LLM-driven prescriptive recommendations:
GROQ_API_KEY=your_groq_api_key_here

# ─── Automated Weekly Email Reporting (SMTP) ──────────────────────────────────
# For Gmail, use an App Password (Google Account > Security > App Passwords)
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_app_password_here
REPORT_RECIPIENT=recipient@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ─── PgAdmin Configuration (Local Docker Only) ────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
