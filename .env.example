# ==============================================================================
# SALES ANALYTICS PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for local development or cloud deployment.
# NEVER commit actual secrets to source control.
# ==============================================================================

# ─── Database Configuration ──────────────────────────────────────────────────
# Single source of truth for the database connection. Set this in your local
# .env file only - never commit a real value.
#   Local Docker Compose:  postgresql://postgres:postgres@localhost:5433/sales_platform
#       (host port 5433 -> container 5432, see docker-compose.yml; containers use postgres:5432)
#   Supabase (session pooler, IPv4-friendly):
#       postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Other cloud PostgreSQL (Neon, RDS, Render, Railway, ...):
#       postgresql://<user>:<password>@<host>:<port>/<database>
# TLS is enforced automatically for non-local hosts (sslmode=require).
# If the password contains reserved URL characters (@ : / ? # etc.), percent-encode them.
DATABASE_URL=

# Fallback local PostgreSQL variables (used only if DATABASE_URL is not set):
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# Connection-pool sizing per app process. Keep low for Supabase's session
# pooler (total client cap ~15). Raise for a larger database / transaction pooler.
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ─── Server & Network Configuration ──────────────────────────────────────────
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated). In production set this to the deployed
# dashboard URL(s). The default covers common local dev hosts.
# Example: CORS_ORIGINS=https://my-sales-app.vercel.app
CORS_ORIGINS=

# ─── GenAI (optional) ────────────────────────────────────────────────────────
# Groq API key enables LLM recommendations; without it a rules engine is used.
GROQ_API_KEY=

# ─── Weekly email reporting (used by GitHub Actions / reports/email_report.py) ─
# For Gmail use an App Password (Google Account > Security > App Passwords).
EMAIL_USERNAME=
EMAIL_PASSWORD=
REPORT_RECIPIENT=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ─── PgAdmin Configuration (Local Docker Only) ────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
